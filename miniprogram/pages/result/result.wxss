.result-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
  padding-bottom: 180rpx;
}

/* 顶部状态栏 */
.result-header {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
}

.status-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #00c853 0%, #00e676 100%);
  padding: 15rpx 30rpx;
  border-radius: 50rpx;
  margin-bottom: 20rpx;
  align-self: flex-start;
  box-shadow: 0 4rpx 12rpx rgba(0, 200, 83, 0.3);
}

.badge-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.badge-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.result-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.meta-item {
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
}

/* 视频区域 */
.video-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
}

.video-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 16/9;
  background: #000;
  border-radius: 16rpx;
  overflow: hidden;
}

.result-video {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.video-loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  color: #fff;
  font-size: 24rpx;
  margin-top: 20rpx;
}

.video-controls {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e0e0e0;
}

.control-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: none;
  border: none;
  padding: 10rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.control-btn::after {
  border: none;
}

.control-icon {
  font-size: 40rpx;
  margin-bottom: 5rpx;
}

.control-label {
  font-size: 22rpx;
}

.control-btn[disabled] {
  opacity: 0.4;
}

/* 视频信息区域 */
.video-info-section {
  margin-bottom: 30rpx;
}

.info-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
}

.info-header {
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #e0e0e0;
  padding-bottom: 15rpx;
}

.info-title {
  color: #333;
  font-size: 28rpx;
  font-weight: 600;
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.info-row {
  display: flex;
  align-items: center;
}

.info-label {
  color: #999;
  font-size: 26rpx;
  width: 140rpx;
}

.info-value {
  color: #333;
  font-size: 26rpx;
  flex: 1;
}

/* 操作按钮区域 */
.actions-section {
  margin-bottom: 30rpx;
}

.actions-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.95);
  border: none;
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.action-btn.primary .btn-icon,
.action-btn.primary .btn-label {
  color: #fff;
}

.action-btn.secondary {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.action-btn.secondary .btn-icon,
.action-btn.secondary .btn-label {
  color: #fff;
}

.btn-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.btn-label {
  font-size: 24rpx;
  color: #333;
}

/* 底部导航 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 1000;
}

.nav-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: none;
  border: none;
  padding: 10rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.nav-btn::after {
  border: none;
}

.nav-icon {
  font-size: 44rpx;
  margin-bottom: 5rpx;
}

.nav-label {
  font-size: 22rpx;
}

/* 提示信息 */
.tips-section {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 16rpx;
  padding: 25rpx;
}

.tips-title {
  color: #667eea;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 15rpx;
  display: block;
}

.tips-text {
  color: #666;
  font-size: 24rpx;
  line-height: 1.8;
  display: block;
  margin-bottom: 5rpx;
}
