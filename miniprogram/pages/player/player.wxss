.container {
  min-height: 100vh;
  background: #000;
  display: flex;
  flex-direction: column;
}

.video-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.video-player {
  width: 100%;
  height: 100vh;
  background: #000;
}

.info-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
  padding: 40rpx 30rpx;
  z-index: 10;
}

.video-title {
  display: block;
  font-size: 32rpx;
  color: white;
  font-weight: bold;
  margin-bottom: 10rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.5);
}

.video-info {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

.action-section {
  position: fixed;
  bottom: 200rpx;
  left: 30rpx;
  right: 30rpx;
  display: flex;
  gap: 20rpx;
  z-index: 10;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  background: rgba(255,255,255,0.9);
  color: #333;
  backdrop-filter: blur(10rpx);
}

.action-btn.download {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.action-btn.share {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: white;
}

.action-btn.back {
  background: rgba(0,0,0,0.6);
  color: white;
  border: 1rpx solid rgba(255,255,255,0.3);
}
