.container {
  position: relative;
  min-height: 100vh;
  background: #000;
  display: flex;
  flex-direction: column;
}

/* ========== 返回按钮 - 左上角 ========== */
.back-btn {
  position: fixed;
  top: 40rpx;
  left: 40rpx;
  z-index: 100;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 36rpx;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  transition: all 0.3s;
}

.back-btn:active {
  transform: scale(0.9);
  background: rgba(0, 0, 0, 0.5);
}

.back-icon {
  font-size: 36rpx;
  color: white;
  font-weight: bold;
}

/* ========== 视频容器 ========== */
.video-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.video-player {
  width: 100%;
  height: 100vh;
  background: #000;
}

/* ========== 底部信息栏 ========== */
.info-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.7) 70%, transparent 100%);
  padding: 60rpx 30rpx 40rpx;
  z-index: 10;
  pointer-events: none;
}

/* Prompt区域 */
.prompt-section {
  margin-bottom: 20rpx;
  pointer-events: auto;
}

.prompt-content {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.prompt-text {
  flex: 1;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.5);
}

.prompt-text.expanded {
  color: rgba(255, 255, 255, 0.95);
}

.expand-btn {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  transition: all 0.3s;
}

.expand-btn:active {
  background: rgba(255, 255, 255, 0.25);
  transform: scale(0.95);
}

.expand-icon {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 元信息 */
.meta-info {
  margin-bottom: 24rpx;
  pointer-events: none;
}

.meta-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.5);
}

/* ========== 进度条 ========== */
.progress-bar-wrapper {
  pointer-events: none;
}

.progress-bar {
  width: 100%;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: white;
  border-radius: 3rpx;
  transition: width 0.3s ease;
  box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.5);
}

.progress-time {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.time-current,
.time-total {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.5);
}
