.container {
  padding: 30rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.content {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
}

.section {
  padding: 40rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section:last-child {
  border-bottom: none;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 20rpx;
}

.section-content {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
}

.faq-item {
  padding: 30rpx 0;
  border-bottom: 1rpx dashed #e0e0e0;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.faq-answer {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  padding-left: 20rpx;
}
