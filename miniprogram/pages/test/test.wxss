.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.section-title.error {
  color: #ff4d4f;
}

.btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  border: none;
  margin-top: 20rpx;
  transition: all 0.3s;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.btn-success {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
}

.btn-info {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.btn-warning {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.btn-disabled {
  background: #ccc;
  color: #666;
}

.info-box {
  background: #f8f9fa;
  padding: 25rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.info-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 15rpx;
}

.info-label:first-child {
  margin-top: 0;
}

.info-value {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-top: 5rpx;
  font-weight: bold;
}

.input-group {
  margin-top: 20rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #f8f9fa;
}

.progress-container {
  margin-top: 30rpx;
  text-align: center;
}

.progress-text {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #07c160;
  margin-top: 15rpx;
}

.progress-status {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

.result-box {
  background: #f0f9ff;
  padding: 25rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.result-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 15rpx;
  font-weight: bold;
}

.result-label:first-child {
  margin-top: 0;
}

.result-value {
  display: block;
  font-size: 24rpx;
  color: #1890ff;
  margin-top: 5rpx;
  word-break: break-all;
  background: #fff;
  padding: 10rpx;
  border-radius: 6rpx;
}

.selectable {
  user-select: text;
}

.break-word {
  word-break: break-all;
  word-wrap: break-word;
}

.video-preview {
  margin-top: 30rpx;
}

.preview-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: bold;
}

.video-player {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  background: #000;
}

.error-message {
  display: block;
  color: #ff4d4f;
  font-size: 28rpx;
  padding: 20rpx;
  background: #fff2f0;
  border-radius: 12rpx;
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}

.footer {
  margin-top: 40rpx;
  opacity: 0.8;
}

.instruction {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
}
