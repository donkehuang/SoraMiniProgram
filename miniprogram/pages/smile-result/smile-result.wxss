/* 容器 */
.container {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  height: 88rpx;
  position: relative;
  z-index: 1;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-left: -8rpx;
  position: relative;
  z-index: 10;
  transition: all 0.3s;
}

.back-btn:active {
  opacity: 0.8;
  transform: scale(0.95);
}

.back-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  font-size: 32rpx;
  line-height: 64rpx;
  color: white;
  font-weight: 400;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 50%;
  letter-spacing: -2rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.navbar-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.navbar-placeholder {
  width: 64rpx;
}

/* 背景视频 */
.background-video {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  object-fit: cover;
}

/* 视频加载提示 */
.video-loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 0;
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  text-align: center;
}

/* 内容层 */
.content-wrapper {
  position: relative;
  z-index: 1;
  padding: 30rpx 30rpx 200rpx;
  min-height: 100vh;
  /* 半透明遮罩，让背景视频可见 */
  background: rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
}

/* 顶部状态栏 */
.status-header {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.success-badge {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.badge-icon {
  font-size: 40rpx;
}

.badge-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.meta-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.meta-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
}

.meta-divider {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 图片展示区域 */
.image-display {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.image-wrapper {
  width: 100%;
  aspect-ratio: 9/16;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #f5f7fa 0%, #e4e8eb 100%);
}

.result-image {
  width: 100%;
  height: 100%;
}

/* 加载动画 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 30rpx;
}

.spinner {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid rgba(134, 239, 172, 0.2);
  border-top-color: #86efac;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #86efac;
}

/* 信息卡片 */
.info-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.1);
}

.info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.info-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.info-label {
  font-size: 28rpx;
  color: #999;
  min-width: 120rpx;
  flex-shrink: 0;
}

.info-content {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  word-break: break-all;
}

/* 操作按钮区域 */
.actions-container {
  margin-bottom: 30rpx;
}

.actions-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 30rpx;
  border-radius: 20rpx;
  border: none;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  gap: 12rpx;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.action-btn.primary {
  background: linear-gradient(135deg, #86efac 0%, #4ade80 100%);
  box-shadow: 0 8rpx 24rpx rgba(74, 222, 128, 0.3);
}

.action-btn.primary .btn-icon,
.action-btn.primary .btn-text {
  color: #ffffff;
}

.btn-icon {
  font-size: 48rpx;
}

.btn-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.action-btn.secondary .btn-text {
  color: #86efac;
}

/* 底部导航 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.nav-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 30rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.nav-btn:active {
  background: rgba(134, 239, 172, 0.15);
}

.nav-icon {
  font-size: 40rpx;
}

.nav-text {
  font-size: 24rpx;
  color: #333;
}

/* 小贴士 */
.tips-section {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  border-radius: 20rpx;
  padding: 24rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.tips-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
}
