.container {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* 背景视频 */
.background-video {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  object-fit: cover;
}

/* 视频加载提示 */
.video-loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 0;
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  text-align: center;
}

/* 内容层 */
.content-wrapper {
  position: relative;
  z-index: 1;
  padding: 40rpx;
  min-height: 100vh;
  /* 半透明遮罩，让背景视频可见 */
  background: rgba(0, 0, 0, 0.3);
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
  color: white;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
}

.input-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(10rpx);
}

.prompt-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

.settings-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(10rpx);
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.setting-label {
  font-size: 28rpx;
  color: #333;
}

.picker {
  font-size: 28rpx;
  color: #667eea;
  padding: 8rpx 24rpx;
  background: #f0f4ff;
  border-radius: 12rpx;
}

.generate-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(240, 147, 251, 0.4);
  transition: all 0.3s;
}

.generate-btn.disabled {
  opacity: 0.6;
  box-shadow: none;
}

.generate-btn:active {
  transform: scale(0.98);
}

.progress-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(10rpx);
}

.progress-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.progress-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 12rpx;
}

.progress-status {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.progress-bar-container {
  width: 100%;
  height: 24rpx;
  background: #e0e0e0;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

.progress-info {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.upload-status {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx;
  background: #e8f4ff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.upload-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #1890ff;
}

.cancel-btn {
  width: 100%;
  height: 80rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
  margin-top: 16rpx;
}

.cancel-btn:active {
  background: #e0e0e0;
}

.result-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(10rpx);
}

.result-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
}

.video-info {
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.video-url {
  display: block;
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
}

.video-player {
  width: 100%;
  height: 900rpx;
  border-radius: 16rpx;
  background: #000;
}

.error-section {
  background: rgba(255, 238, 238, 0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(254, 85, 85, 0.3);
  backdrop-filter: blur(10rpx);
}

.error-text {
  color: #c00;
  font-size: 28rpx;
  line-height: 1.6;
}
