.container {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* 背景视频 */
.background-video {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  object-fit: cover;
}

/* 视频加载提示 */
.video-loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 0;
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  text-align: center;
}

/* 内容层 */
.content-wrapper {
  position: relative;
  z-index: 1;
  padding: 40rpx;
  min-height: 100vh;
  /* 半透明遮罩，让背景视频可见 */
  background: rgba(0, 0, 0, 0.3);
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
  color: white;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
}

/* ========== 主界面：功能列表 ========== */
.main-view {
  width: 100%;
  margin-top: 80rpx;
}

/* 功能列表容器 */
.function-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 0 0rpx;
}

/* 单列功能列表 */
.function-list-single {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 0rpx;
  margin-bottom: 24rpx;
}

/* 双列功能列表 */
.function-list-double {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 0 0rpx;
  grid-template-rows: auto auto;
}

/* 单列功能项 */
.function-item-single {
  background-size: cover;
  background-position: center;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  transition: all 0.3s;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  position: relative;
  overflow: hidden;
  height: 160rpx;
  width: calc(100% - 32rpx);
}

/* 视频背景功能项 */
.function-item-video {
  background: none;
}

.function-item-video .function-background-video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: -1;
}

.function-item-video .function-background-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

/* 功能项 */
.function-item {
  background-size: cover;
  background-position: center;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  transition: all 0.3s;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  position: relative;
  overflow: hidden;
  height: 180rpx;
  width: 100%;
}

/* 遮罩层 */
.function-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.6) 100%);
  backdrop-filter: blur(0);
  -webkit-backdrop-filter: blur(0);
  z-index: 0;
}

.function-item:active {
  transform: scale(0.98);
}

.function-item:active .function-overlay {
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.6) 100%);
}

.function-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.function-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
  text-align: center;
}

.function-title {
  font-size: 26rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.95);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
  margin-bottom: 8rpx;
}

.function-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.5);
}

.function-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 16rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  display: none;
}

/* ========== 生图界面 ========== */
.image-view {
  width: 100%;
  padding-top: 80rpx;  /* 为左上角返回按钮留出空间 */
}

/* 生图结果区域 */
.image-result-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(10rpx);
}

/* 优化图片区域 */
.optimize-section {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #e0e0e0;
}

.optimize-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.optimize-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.optimize-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.optimize-input-wrapper {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #e0e0e0;
}

.optimize-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #333;
  background: transparent;
}

.optimize-input::placeholder {
  color: #ccc;
}

.optimize-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.optimize-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

/* 让照片变清晰界面 */
.enhance-view {
  animation: slideIn 0.3s ease;
}

/* 励志视频界面 */
.motivational-view {
  animation: fadeIn 0.3s ease;
}

/* 宠物开口说话界面 */
.pet-talk-view {
  animation: fadeIn 0.3s ease;
}

/* 台词输入区域 */
.dialogue-section {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
}

.dialogue-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.dialogue-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.dialogue-title {
  font-size: 28rpx;
  font-weight: bold;
  color: white;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

.dialogue-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: white;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}

.dialogue-input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

/* 随机台词按钮 */
.random-dialogue-btn {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  color: white;
  font-size: 28rpx;
  border-radius: 48rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s;
}

.random-dialogue-btn:active {
  background: rgba(255, 255, 255, 0.25);
  transform: scale(0.98);
}

.random-icon {
  font-size: 32rpx;
}

.pet-preview {
  width: 100%;
  height: 400rpx;
}

/* 输入方式切换标签 */
.input-mode-tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 8rpx;
  margin: 24rpx 0;
}

.input-mode-tabs .tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  border-radius: 12rpx;
  transition: all 0.3s;
}

.input-mode-tabs .tab.active {
  background: rgba(255, 255, 255, 0.3);
  color: white;
  font-weight: bold;
}

/* 语音输入区域 */
.voice-input-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.voice-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.voice-btn:active {
  transform: scale(0.95);
}

.voice-btn.is-recording {
  animation: pulse 1.5s infinite;
}

.voice-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.voice-text {
  font-size: 24rpx;
}

.voice-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 32rpx;
}

/* 视频风格选择 */
.style-selector {
  margin-top: 32rpx;
}

.style-header {
  margin-bottom: 24rpx;
}

.style-title {
  font-size: 30rpx;
  font-weight: bold;
  color: white;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

.style-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.style-item {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s;
  border: 2rpx solid transparent;
}

.style-item.active {
  background: rgba(255, 255, 255, 0.3);
  border-color: rgba(102, 126, 234, 0.5);
}

.style-item:active {
  transform: scale(0.98);
}

.style-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.style-name {
  font-size: 26rpx;
  color: white;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 录音脉冲动画 */
@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(102, 126, 234, 0.4);
  }
  70% {
    box-shadow: 0 0 0 40rpx rgba(102, 126, 234, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(102, 126, 234, 0);
  }
}

.upload-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.image-preview-container {
  margin: 32rpx 0;
  min-height: 400rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.smile-preview,
.enhance-preview {
  width: 100%;
  height: 400rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #999;
}

/* 开口笑选项 */
.output-options {
  margin: 32rpx 0;
}

/* 让照片变清晰选项 */
.enhance-options {
  margin: 32rpx 0;
}

.option-header {
  margin-bottom: 24rpx;
}

.option-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.option-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.option-item:last-child {
  border-bottom: none;
}

.option-radio {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #ddd;
  border-radius: 50%;
  margin-right: 24rpx;
  margin-top: 8rpx;
  flex-shrink: 0;
  position: relative;
}

.option-radio.active::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
}

.option-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.option-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.option-desc {
  font-size: 24rpx;
  color: #999;
}

/* 视频播放区域 */
.result-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.result-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.video-info {
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.video-url {
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
}

.video-player {
  width: 100%;
  border-radius: 16rpx;
}

/* 错误信息 */
.error-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.error-text {
  display: block;
  font-size: 28rpx;
  color: #ff4d4f;
  margin-bottom: 24rpx;
  text-align: center;
}

.debug-info {
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 16rpx;
}

.debug-title {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.debug-text {
  display: block;
  font-size: 22rpx;
  color: #666;
  margin-bottom: 4rpx;
  word-break: break-all;
}

/* 动画 */
@keyframes slideIn {
  from {
    transform: translateX(100%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.image-display {
  margin: 24rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.generated-image {
  width: 100%;
  height: 720rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
}

.image-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.25) 0%, rgba(118, 75, 162, 0.25) 100%);
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: 1px solid rgba(255, 255, 255, 0.35);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.secondary {
  background: rgba(255, 255, 255, 0.2);
}

.action-btn:active {
  transform: scale(0.98);
}

/* ========== 创作界面 ========== */
.create-view {
  width: 100%;
  padding-top: 80rpx;  /* 为左上角返回按钮留出空间 */
}

/* 返回按钮 - 左上角固定 */
.back-btn {
  position: fixed;
  top: 40rpx;
  left: 40rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 48rpx;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s;
}

.back-btn:active {
  background: rgba(255, 255, 255, 0.35);
  transform: scale(0.95);
}

.back-icon {
  font-size: 32rpx;
  color: white;
  margin-right: 8rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

.back-text {
  font-size: 28rpx;
  color: white;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 输入标签 */
.input-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.label-text {
  font-size: 28rpx;
  font-weight: bold;
  color: white;  /* 白色文字 */
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 设置项标签 */
.setting-label {
  display: flex;
  align-items: center;
}

.setting-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.setting-text {
  font-size: 28rpx;
  color: white;  /* 白色文字 */
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

.input-section {
  background: rgba(255, 255, 255, 0.2);  /* 更透明 */
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(20rpx);  /* 增强磨砂效果 */
  -webkit-backdrop-filter: blur(20rpx);
  border: 1px solid rgba(255, 255, 255, 0.3);  /* 玻璃边框 */
}

.prompt-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: white;  /* 白色文字 */
  background: transparent;
}

.prompt-input::placeholder {
  color: rgba(255, 255, 255, 0.6);  /* 白色半透明占位符 */
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);  /* 白色半透明 */
  margin-top: 16rpx;
}

.settings-section {
  background: rgba(255, 255, 255, 0.2);  /* 更透明 */
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(20rpx);  /* 增强磨砂效果 */
  -webkit-backdrop-filter: blur(20rpx);
  border: 1px solid rgba(255, 255, 255, 0.3);  /* 玻璃边框 */
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.setting-item:last-child {
  margin-bottom: 0;
}

.picker {
  font-size: 28rpx;
  color: white;  /* 白色文字 */
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);  /* 半透明背景 */
  border-radius: 12rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.generate-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.25) 0%, rgba(118, 75, 162, 0.25) 100%);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: 1px solid rgba(255, 255, 255, 0.35);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  backdrop-filter: blur(30rpx);  /* 增强磨砂效果 */
  -webkit-backdrop-filter: blur(30rpx);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.generate-btn.disabled {
  opacity: 0.5;
  box-shadow: none;
}

.generate-btn:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.35) 0%, rgba(118, 75, 162, 0.35) 100%);
}

.progress-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(10rpx);
}

.progress-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.progress-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 12rpx;
}

.progress-status {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.progress-bar-container {
  width: 100%;
  height: 24rpx;
  background: #e0e0e0;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

.progress-info {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.upload-status {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx;
  background: #e8f4ff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.upload-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #1890ff;
}

.cancel-btn {
  width: 100%;
  height: 80rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
  margin-top: 16rpx;
}

.cancel-btn:active {
  background: #e0e0e0;
}

.result-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(10rpx);
}

.result-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
}

.video-info {
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.video-url {
  display: block;
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
}

.video-player {
  width: 100%;
  height: 900rpx;
  border-radius: 16rpx;
  background: #000;
}

.error-section {
  background: rgba(255, 238, 238, 0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(254, 85, 85, 0.3);
  backdrop-filter: blur(10rpx);
}

.error-text {
  color: #c00;
  font-size: 28rpx;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.debug-info {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.1);
}

.debug-title {
  color: #666;
  font-size: 24rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.debug-text {
  color: #999;
  font-size: 22rpx;
  display: block;
  line-height: 1.5;
  word-break: break-all;
}

/* ========== 我是达芬奇界面 ========== */
.davinci-view {
  animation: fadeIn 0.3s ease;
}

/* 达芬奇风格选择网格 */
.davinci-style-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin: 32rpx 0;
}

.davinci-style-item {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s;
  border: 2rpx solid transparent;
}

.davinci-style-item.active {
  background: rgba(255, 255, 255, 0.3);
  border-color: rgba(102, 126, 234, 0.5);
}

.davinci-style-item:active {
  transform: scale(0.98);
}

.davinci-style-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.davinci-style-name {
  font-size: 26rpx;
  font-weight: bold;
  color: white;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
  margin-bottom: 4rpx;
}

.davinci-style-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
}

/* 达芬奇图片上传区域 */
.davinci-upload-section {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
}

.davinci-preview {
  width: 100%;
  height: 400rpx;
}

/* 达芬奇输出类型选择 */
.davinci-output-section {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
}

.output-label {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.davinci-output-options {
  margin: 24rpx 0;
}

/* 达芬奇子风格选择 */
.davinci-substyle-section {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
}

.substyle-label {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.substyle-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.substyle-item {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  padding: 16rpx;
  transition: all 0.3s;
}

.substyle-item:active {
  transform: scale(0.98);
}

.substyle-preview {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.substyle-preview.active {
  background: rgba(102, 126, 234, 0.3);
  border-color: rgba(102, 126, 234, 0.6);
}

.substyle-name {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: white;
  text-align: center;
}

.substyle-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
  line-height: 1.4;
}
