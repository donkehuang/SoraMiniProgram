.container {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* 背景视频 */
.background-video {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  object-fit: cover;
}

/* 视频加载提示 */
.video-loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 0;
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  text-align: center;
}

/* 内容层 */
.content-wrapper {
  position: relative;
  z-index: 1;
  padding: 40rpx;
  min-height: 100vh;
  /* 半透明遮罩，让背景视频可见 */
  background: rgba(0, 0, 0, 0.3);
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
  color: white;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
}

/* ========== 主界面：功能卡片 ========== */
.main-view {
  width: 100%;
  margin-top: 320rpx;  /* 再往下移 */
}

/* 大卡片：立即进入创作 */
.card-create {
  margin: 0 20rpx 32rpx 20rpx;  /* 统一使用 margin，确保对称 */
  height: 110rpx;  /* 更扁 */
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);  /* 更透明 0.15 */
  border-radius: 24rpx;
  padding: 24rpx 32rpx;  /* 调整内边距 */
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.2);
  backdrop-filter: blur(30rpx);  /* 增强磨砂玻璃效果 */
  -webkit-backdrop-filter: blur(30rpx);
  border: 1px solid rgba(255, 255, 255, 0.25);  /* 稍微降低边框不透明度 */
  display: flex;
  flex-direction: row;  /* 改为横向排列 */
  align-items: center;
  position: relative;
  overflow: hidden;
  transition: all 0.3s;
}

.card-create:active {
  transform: scale(0.98);
}

.card-create .card-icon {
  font-size: 48rpx;  /* 图标稍小 */
  margin-right: 20rpx;  /* 右边距，与文字分开 */
  flex-shrink: 0;  /* 不收缩 */
}

.card-create .card-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.card-create .card-title {
  font-size: 30rpx;  /* 字号稍小 */
  font-weight: bold;
  color: white;
  margin-bottom: 2rpx;  /* 减少间距 */
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.card-create .card-desc {
  font-size: 20rpx;  /* 字号更小 */
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 小卡片容器 */
.small-cards-row {
  display: flex;
  justify-content: space-between;  /* 两端对齐 */
  gap: 16rpx;  /* 卡片之间的间距 */
  margin: 0 20rpx;  /* 左右边距与大卡片对齐 */
}

/* 小卡片 */
.card-small {
  flex: 1;  /* 平分宽度，自动填满 */
  height: 100rpx;  /* 扁平高度 */
  background: rgba(255, 255, 255, 0.15);  /* 更透明 0.15 */
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(30rpx);  /* 增强磨砂玻璃效果 */
  -webkit-backdrop-filter: blur(30rpx);
  border: 1px solid rgba(255, 255, 255, 0.25);  /* 稍微降低边框不透明度 */
  display: flex;
  flex-direction: row;  /* 横向布局 */
  align-items: center;  /* 垂直居中 */
  transition: all 0.3s;
}

.card-small:active {
  transform: scale(0.95);
}

.card-small .card-icon-small {
  font-size: 44rpx;
  margin-right: 12rpx;  /* 图标右边距 */
  flex-shrink: 0;
}

.card-small .card-small-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.card-small .card-title-small {
  font-size: 26rpx;
  font-weight: bold;
  color: white;  /* 改为白色 */
  margin-bottom: 2rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

.card-small .card-desc-small {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);  /* 改为白色半透明 */
}

/* ========== 创作界面 ========== */
.create-view {
  width: 100%;
}

/* 返回按钮 */
.back-btn {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-bottom: 32rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 48rpx;
  width: fit-content;
  transition: all 0.3s;
}

.back-btn:active {
  background: rgba(255, 255, 255, 0.3);
}

.back-icon {
  font-size: 32rpx;
  color: white;
  margin-right: 8rpx;
}

.back-text {
  font-size: 28rpx;
  color: white;
}

/* 输入标签 */
.input-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.label-text {
  font-size: 28rpx;
  font-weight: bold;
  color: white;  /* 白色文字 */
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 设置项标签 */
.setting-label {
  display: flex;
  align-items: center;
}

.setting-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.setting-text {
  font-size: 28rpx;
  color: white;  /* 白色文字 */
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

.input-section {
  background: rgba(255, 255, 255, 0.2);  /* 更透明 */
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(20rpx);  /* 增强磨砂效果 */
  -webkit-backdrop-filter: blur(20rpx);
  border: 1px solid rgba(255, 255, 255, 0.3);  /* 玻璃边框 */
}

.prompt-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: white;  /* 白色文字 */
  background: transparent;
}

.prompt-input::placeholder {
  color: rgba(255, 255, 255, 0.6);  /* 白色半透明占位符 */
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);  /* 白色半透明 */
  margin-top: 16rpx;
}

.settings-section {
  background: rgba(255, 255, 255, 0.2);  /* 更透明 */
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(20rpx);  /* 增强磨砂效果 */
  -webkit-backdrop-filter: blur(20rpx);
  border: 1px solid rgba(255, 255, 255, 0.3);  /* 玻璃边框 */
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.setting-item:last-child {
  margin-bottom: 0;
}

.picker {
  font-size: 28rpx;
  color: white;  /* 白色文字 */
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);  /* 半透明背景 */
  border-radius: 12rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.generate-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, rgba(240, 147, 251, 0.9) 0%, rgba(245, 87, 108, 0.9) 100%);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);  /* 玻璃边框 */
  box-shadow: 0 8rpx 24rpx rgba(240, 147, 251, 0.4);
  backdrop-filter: blur(10rpx);  /* 磨砂效果 */
  -webkit-backdrop-filter: blur(10rpx);
  transition: all 0.3s;
}

.generate-btn.disabled {
  opacity: 0.6;
  box-shadow: none;
}

.generate-btn:active {
  transform: scale(0.98);
}

.progress-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(10rpx);
}

.progress-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.progress-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 12rpx;
}

.progress-status {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.progress-bar-container {
  width: 100%;
  height: 24rpx;
  background: #e0e0e0;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

.progress-info {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.upload-status {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx;
  background: #e8f4ff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.upload-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #1890ff;
}

.cancel-btn {
  width: 100%;
  height: 80rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
  margin-top: 16rpx;
}

.cancel-btn:active {
  background: #e0e0e0;
}

.result-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(10rpx);
}

.result-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
}

.video-info {
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.video-url {
  display: block;
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
}

.video-player {
  width: 100%;
  height: 900rpx;
  border-radius: 16rpx;
  background: #000;
}

.error-section {
  background: rgba(255, 238, 238, 0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(254, 85, 85, 0.3);
  backdrop-filter: blur(10rpx);
}

.error-text {
  color: #c00;
  font-size: 28rpx;
  line-height: 1.6;
}
