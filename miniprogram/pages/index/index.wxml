<view class="container">
  <!-- 背景视频 -->
  <video 
    wx:if="{{showBackgroundVideo && backgroundVideoUrl}}"
    class="background-video" 
    src="{{backgroundVideoUrl}}" 
    autoplay 
    loop 
    muted
    show-center-play-btn="{{false}}"
    show-play-btn="{{false}}"
    show-fullscreen-btn="{{false}}"
    controls="{{false}}"
    objectFit="cover"
    binderror="onBackgroundVideoError"
    bindplay="onBackgroundVideoPlay"
  ></video>
  
  <!-- 加载提示 -->
  <view wx:if="{{!showBackgroundVideo && backgroundVideoLoading}}" class="video-loading">
    <text>背景加载中...</text>
  </view>
  
  <!-- 内容层 -->
  <view class="content-wrapper">
    <view class="header">
      <text class="title">Sora AI 创作</text>
      <text class="subtitle">文字生视频 · 专业创作工具</text>
    </view>

    <!-- 主界面：显示功能卡片 -->
    <view class="main-view" wx:if="{{!showCreateView && !showImageView && !showSmileView && !showEnhanceView && !showMotivationalView && !showPetTalkView && !showDaVinciView && !isGenerating}}">
      <!-- 卡片1：开口笑（大卡片） -->
      <view class="card card-create" bindtap="enterSmile">
        <view class="card-icon">😊</view>
        <view class="card-content">
          <view class="card-title">开口笑</view>
          <view class="card-desc">上传照片，让TA开口笑</view>
        </view>
      </view>

      <!-- 小卡片容器 -->
      <view class="small-cards-row">
        <!-- 卡片2：让照片变清晰 -->
        <view class="card card-small" bindtap="enterEnhance">
          <view class="card-icon-small">✨</view>
          <view class="card-small-content">
            <view class="card-title-small">让照片变清晰</view>
            <view class="card-desc-small">高清修复+动态效果</view>
          </view>
        </view>

        <!-- 卡片3：励志视频 -->
        <view class="card card-small" bindtap="enterMotivational">
          <view class="card-icon-small">🎬</view>
          <view class="card-small-content">
            <view class="card-title-small">励志视频</view>
            <view class="card-desc-small">古风+励志台词</view>
          </view>
        </view>

        <!-- 卡片4：宠物开口说话 -->
        <view class="card card-small" bindtap="enterPetTalk">
          <view class="card-icon-small">🐱</view>
          <view class="card-small-content">
            <view class="card-title-small">宠物开口说话</view>
            <view class="card-desc-small">搞笑台词+8秒视频</view>
          </view>
        </view>

        <!-- 卡片5：我是达芬奇 -->
        <view class="card card-small" bindtap="enterDaVinci">
          <view class="card-icon-small">🎨</view>
          <view class="card-small-content">
            <view class="card-title-small">我是达芬奇</view>
            <view class="card-desc-small">风格化+图片/视频</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 让照片变清晰界面 -->
    <view class="enhance-view" wx:if="{{showEnhanceView && !isGenerating}}">
      <!-- 返回按钮 -->
      <view class="back-btn" bindtap="backToMain">
        <text class="back-icon">←</text>
        <text class="back-text">返回</text>
      </view>

      <!-- 图片选择区域 -->
      <view class="upload-section">
        <view class="upload-label">
          <text class="label-icon">📷</text>
          <text class="label-text">选择照片</text>
        </view>

        <!-- 图片预览 -->
        <view class="image-preview-container" bindtap="chooseEnhanceImage">
          <image
            wx:if="{{enhanceImageUrl}}"
            class="enhance-preview"
            src="{{enhanceImageUrl}}"
            mode="aspectFit"
          />
          <view wx:else class="upload-placeholder">
            <text class="upload-icon">📸</text>
            <text class="upload-text">点击选择照片</text>
          </view>
        </view>

        <!-- 功能选项 -->
        <view class="enhance-options">
          <view class="option-header">
            <text class="option-title">选择功能</text>
          </view>
          
          <view class="option-item" bindtap="onEnhanceTypeChange" data-type="upscale">
            <view class="option-radio {{enhanceType === 'upscale' ? 'active' : ''}}"></view>
            <view class="option-content">
              <text class="option-text">提高分辨率（高清修复）</text>
              <text class="option-desc">让照片更清晰、更锐利</text>
            </view>
          </view>
          
          <view class="option-item" bindtap="onEnhanceTypeChange" data-type="animate">
            <view class="option-radio {{enhanceType === 'animate' ? 'active' : ''}}"></view>
            <view class="option-content">
              <text class="option-text">让照片动起来</text>
              <text class="option-desc">轻微晃动效果，4秒视频</text>
            </view>
          </view>
        </view>

        <!-- 生成按钮 -->
        <button class="generate-btn" bindtap="generateEnhance" disabled="{{!enhanceImageUrl}}">
          {{enhanceType === 'upscale' ? '提高分辨率' : '生成动态照片'}}
        </button>
      </view>
    </view>

    <!-- 生图界面：显示输入表单 -->
    <view class="image-view" wx:if="{{showImageView && !isGenerating}}">
      <!-- 返回按钮 -->
      <view class="back-btn" bindtap="backToMain">
        <text class="back-icon">←</text>
        <text class="back-text">返回</text>
      </view>

      <!-- 输入区域 -->
      <view class="input-section">
        <view class="input-label">
          <text class="label-icon">🖼️</text>
          <text class="label-text">图片描述</text>
        </view>
        <textarea
          class="prompt-input"
          placeholder="请输入图片描述，例如：一只可爱的小猫在草地上玩耍..."
          value="{{imagePrompt}}"
          bindinput="onImagePromptInput"
          maxlength="500"
          auto-height
        />
        <text class="char-count">{{imagePrompt.length}}/500</text>
      </view>

      <!-- 设置区域 -->
      <view class="settings-section">
        <!-- 图片方向 -->
        <view class="setting-item">
          <view class="setting-label">
            <text class="setting-icon">📐</text>
            <text class="setting-text">图片方向</text>
          </view>
          <picker mode="selector" range="{{imageOrientationOptions}}" value="{{imageOrientationIndex}}" bindchange="onImageOrientationChange">
            <view class="picker">{{imageOrientationOptions[imageOrientationIndex]}}</view>
          </picker>
        </view>
      </view>

      <!-- 生成按钮 -->
      <button class="generate-btn" bindtap="generateImage">
        生成图片
      </button>
    </view>

    <!-- 开口笑界面 -->
    <view class="smile-view" wx:if="{{showSmileView && !isGenerating}}">
      <!-- 返回按钮 -->
      <view class="back-btn" bindtap="backToMain">
        <text class="back-icon">←</text>
        <text class="back-text">返回</text>
      </view>

      <!-- 图片选择区域 -->
      <view class="upload-section">
        <view class="upload-label">
          <text class="label-icon">📷</text>
          <text class="label-text">选择照片</text>
        </view>

        <!-- 图片预览 -->
        <view class="image-preview-container" bindtap="chooseSmileImage">
          <image
            wx:if="{{smileImageUrl}}"
            class="smile-preview"
            src="{{smileImageUrl}}"
            mode="aspectFit"
          />
          <view wx:else class="upload-placeholder">
            <text class="upload-icon">📸</text>
            <text class="upload-text">点击选择照片</text>
          </view>
        </view>

        <!-- 输出选项 -->
        <view class="output-options">
          <view class="option-item" bindtap="onOutputTypeChange" data-type="image">
            <view class="option-radio {{smileOutputType === 'image' ? 'active' : ''}}"></view>
            <text class="option-text">生成开口笑图片</text>
          </view>
          <view class="option-item" bindtap="onOutputTypeChange" data-type="video">
            <view class="option-radio {{smileOutputType === 'video' ? 'active' : ''}}"></view>
            <text class="option-text">生成开口笑视频（4秒）</text>
          </view>
        </view>

        <!-- 生成按钮 -->
        <button class="generate-btn" bindtap="generateSmile" disabled="{{!smileImageUrl}}">
          {{smileOutputType === 'image' ? '生成开口笑图片' : '生成开口笑视频'}}
        </button>
      </view>
    </view>

    <!-- 励志视频界面 -->
    <view class="motivational-view" wx:if="{{showMotivationalView && !isGenerating}}">
      <!-- 返回按钮 -->
      <view class="back-btn" bindtap="backToMain">
        <text class="back-icon">←</text>
        <text class="back-text">返回</text>
      </view>

      <!-- 输入方式选择 -->
      <view class="input-section">
        <view class="input-label">
          <text class="label-icon">💬</text>
          <text class="label-text">输入励志内容</text>
        </view>

        <!-- 输入方式切换 -->
        <view class="input-mode-tabs">
          <view class="tab {{inputMode === 'text' ? 'active' : ''}}" bindtap="onInputModeChange" data-mode="text">
            <text>打字输入</text>
          </view>
          <view class="tab {{inputMode === 'voice' ? 'active' : ''}}" bindtap="onInputModeChange" data-mode="voice">
            <text>语音输入</text>
          </view>
        </view>

        <!-- 打字输入 -->
        <view wx:if="{{inputMode === 'text'}}">
          <textarea
            class="prompt-input"
            placeholder="请输入一段励志内容，例如：坚持不懈，终将成功..."
            value="{{motivationalText}}"
            bindinput="onMotivationalTextInput"
            maxlength="200"
            auto-height
          />
          <text class="char-count">{{motivationalText.length}}/200</text>
        </view>

        <!-- 语音输入 -->
        <view wx:else class="voice-input-area">
          <button class="voice-btn" bindtouchstart="startRecording" bindtouchend="stopRecording">
            <text class="voice-icon">🎤</text>
            <text class="voice-text">{{isRecording ? '录音中...' : '按住说话'}}</text>
          </button>
          <text class="voice-hint">按住按钮说话，松开结束</text>
        </view>

        <!-- 视频风格选择 -->
        <view class="style-selector">
          <view class="style-header">
            <text class="style-title">选择视频风格</text>
          </view>
          <view class="style-grid">
            <view class="style-item {{motivationalStyle === 'landscape' ? 'active' : ''}}" bindtap="onStyleChange" data-style="landscape">
              <view class="style-icon">🏔️</view>
              <text class="style-name">自然景观</text>
            </view>
            <view class="style-item {{motivationalStyle === 'tea' ? 'active' : ''}}" bindtap="onStyleChange" data-style="tea">
              <view class="style-icon">🍵</view>
              <text class="style-name">采茶古风</text>
            </view>
            <view class="style-item {{motivationalStyle === 'garden' ? 'active' : ''}}" bindtap="onStyleChange" data-style="garden">
              <view class="style-icon">🏮</view>
              <text class="style-name">庭院古风</text>
            </view>
            <view class="style-item {{motivationalStyle === 'bamboo' ? 'active' : ''}}" bindtap="onStyleChange" data-style="bamboo">
              <view class="style-icon">🎋</view>
              <text class="style-name">竹林古韵</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 生成按钮 -->
      <button class="generate-btn" bindtap="generateMotivationalVideo" disabled="{{!motivationalText}}">
        生成励志视频
      </button>
    </view>

    <!-- 宠物开口说话界面 -->
    <view class="pet-talk-view" wx:if="{{showPetTalkView && !isGenerating}}">
      <!-- 返回按钮 -->
      <view class="back-btn" bindtap="backToMain">
        <text class="back-icon">←</text>
        <text class="back-text">返回</text>
      </view>

      <!-- 图片选择区域 -->
      <view class="upload-section">
        <view class="upload-label">
          <text class="label-icon">📷</text>
          <text class="label-text">上传宠物照片</text>
        </view>

        <!-- 图片预览 -->
        <view class="image-preview-container" bindtap="choosePetImage">
          <image
            wx:if="{{petImageUrl}}"
            class="pet-preview"
            src="{{petImageUrl}}"
            mode="aspectFit"
          />
          <view wx:else class="upload-placeholder">
            <text class="upload-icon">📸</text>
            <text class="upload-text">点击选择宠物照片</text>
          </view>
        </view>

        <!-- 台词输入 -->
        <view class="dialogue-section">
          <view class="dialogue-label">
            <text class="dialogue-icon">💬</text>
            <text class="dialogue-title">想让宠物说的话</text>
          </view>
          <textarea
            class="dialogue-input"
            placeholder="不输入将随机生成搞笑台词"
            value="{{petDialogue}}"
            bindinput="onPetDialogueInput"
            maxlength="100"
            auto-height
          />
          <text class="char-count">{{petDialogue.length}}/100</text>

          <!-- 随机台词按钮 -->
          <button class="random-dialogue-btn" bindtap="generateRandomDialogue">
            <text class="random-icon">🎲</text>
            <text>随机生成搞笑台词</text>
          </button>
        </view>
      </view>

      <!-- 生成按钮 -->
      <button class="generate-btn" bindtap="generatePetTalkVideo" disabled="{{!petImageUrl}}">
        生成宠物说话视频
      </button>
    </view>

    <!-- 我是达芬奇界面 -->
    <view class="davinci-view" wx:if="{{showDaVinciView && !isGenerating}}">
      <!-- 返回按钮 -->
      <view class="back-btn" bindtap="backToMain">
        <text class="back-icon">←</text>
        <text class="back-text">返回</text>
      </view>

      <!-- 绘画风格选择 -->
      <view class="upload-section">
        <view class="upload-label">
          <text class="label-icon">🎨</text>
          <text class="label-text">选择绘画风格</text>
        </view>

        <!-- 风格选择网格 -->
        <view class="davinci-style-grid">
          <view class="davinci-style-item {{davinciStyle === 'oil' ? 'active' : ''}}" bindtap="onDavinciStyleChange" data-style="oil">
            <view class="davinci-style-icon">🖼️</view>
            <text class="davinci-style-name">油画</text>
            <text class="davinci-style-desc">经典油画质感</text>
          </view>
          <view class="davinci-style-item {{davinciStyle === 'pencil' ? 'active' : ''}}" bindtap="onDavinciStyleChange" data-style="pencil">
            <view class="davinci-style-icon">✏️</view>
            <text class="davinci-style-name">铅笔画</text>
            <text class="davinci-style-desc">精致素描风格</text>
          </view>
          <view class="davinci-style-item {{davinciStyle === 'ink' ? 'active' : ''}}" bindtap="onDavinciStyleChange" data-style="ink">
            <view class="davinci-style-icon">🌊</view>
            <text class="davinci-style-name">水墨画</text>
            <text class="davinci-style-desc">东方水墨韵味</text>
          </view>
        </view>

        <!-- 图片上传 -->
        <view class="davinci-upload-section">
          <view class="upload-label">
            <text class="label-icon">📷</text>
            <text class="label-text">上传图片（可选）</text>
          </view>

          <view class="image-preview-container" bindtap="chooseDaVinciImage">
            <image
              wx:if="{{davinciImageUrl}}"
              class="davinci-preview"
              src="{{davinciImageUrl}}"
              mode="aspectFit"
            />
            <view wx:else class="upload-placeholder">
              <text class="upload-icon">📸</text>
              <text class="upload-text">点击上传参考图片</text>
            </view>
          </view>
        </view>

        <!-- 文字描述输入 -->
        <view class="input-section">
          <view class="input-label">
            <text class="label-icon">✍️</text>
            <text class="label-text">描述内容</text>
          </view>
          <textarea
            class="prompt-input"
            placeholder="描述您想要生成的画面，例如：一位古典美人手持折扇..."
            value="{{davinciText}}"
            bindinput="onDavinciTextInput"
            maxlength="500"
            auto-height
          />
          <text class="char-count">{{davinciText.length}}/500</text>
        </view>

        <!-- 输出类型选择 -->
        <view class="davinci-output-section">
          <view class="output-label">
            <text class="label-icon">🎬</text>
            <text class="label-text">选择输出类型</text>
          </view>

          <view class="davinci-output-options">
            <view class="option-item" bindtap="onDavinciOutputTypeChange" data-type="image">
              <view class="option-radio {{davinciOutputType === 'image' ? 'active' : ''}}"></view>
              <view class="option-content">
                <text class="option-text">生成图片</text>
                <text class="option-desc">生成一张风格化图片</text>
              </view>
            </view>
            <view class="option-item" bindtap="onDavinciOutputTypeChange" data-type="video">
              <view class="option-radio {{davinciOutputType === 'video' ? 'active' : ''}}"></view>
              <view class="option-content">
                <text class="option-text">生成视频（8秒）</text>
                <text class="option-desc">生成8秒动态视频</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 优化子风格选择（当选择了某个主风格时显示） -->
        <view class="davinci-substyle-section" wx:if="{{davinciStyle}}">
          <view class="substyle-label">
            <text class="label-icon">⭐</text>
            <text class="label-text">选择优化风格</text>
          </view>

          <view class="substyle-grid">
            <view wx:for="{{davinciSubStyles}}" wx:key="id" class="substyle-item" bindtap="onDavinciSubStyleChange" data-substyle="{{item.id}}">
              <view class="substyle-preview {{selectedDavinciSubStyle === item.id ? 'active' : ''}}">
                <text class="substyle-name">{{item.name}}</text>
              </view>
              <view class="substyle-desc">{{item.description}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 生成按钮 -->
      <button class="generate-btn" bindtap="generateDaVinciWork" disabled="{{!davinciText}}">
        {{davinciOutputType === 'image' ? '生成画作' : '生成视频'}}
      </button>
    </view>

    <!-- 创作界面：显示输入表单 -->
    <view class="create-view" wx:if="{{showCreateView && !isGenerating}}">
      <!-- 返回按钮 -->
      <view class="back-btn" bindtap="backToMain">
        <text class="back-icon">←</text>
        <text class="back-text">返回</text>
      </view>

      <!-- 输入区域 -->
      <view class="input-section">
        <view class="input-label">
          <text class="label-icon">📝</text>
          <text class="label-text">视频描述</text>
        </view>
        <textarea
          class="prompt-input"
          placeholder="请输入视频描述，例如：一只可爱的小猫在草地上奔跑..."
          value="{{prompt}}"
          bindinput="onPromptInput"
          maxlength="500"
          auto-height
        />
        <text class="char-count">{{prompt.length}}/500</text>
      </view>

      <!-- 设置区域 -->
      <view class="settings-section">
        <!-- 视频时长 -->
        <view class="setting-item">
          <view class="setting-label">
            <text class="setting-icon">⏱️</text>
            <text class="setting-text">视频时长</text>
          </view>
          <picker mode="selector" range="{{durationOptions}}" value="{{durationIndex}}" bindchange="onDurationChange">
            <view class="picker">{{durationOptions[durationIndex]}}</view>
          </picker>
        </view>

        <!-- 视频方向 -->
        <view class="setting-item">
          <view class="setting-label">
            <text class="setting-icon">📐</text>
            <text class="setting-text">视频方向</text>
          </view>
          <picker mode="selector" range="{{orientationOptions}}" value="{{orientationIndex}}" bindchange="onOrientationChange">
            <view class="picker">{{orientationOptions[orientationIndex]}}</view>
          </picker>
        </view>

        <!-- 预设风格 -->
        <view class="setting-item">
          <view class="setting-label">
            <text class="setting-icon">🎨</text>
            <text class="setting-text">预设风格</text>
          </view>
          <picker mode="selector" range="{{styleOptions}}" value="{{styleIndex}}" bindchange="onStyleChange">
            <view class="picker">{{styleOptions[styleIndex]}}</view>
          </picker>
        </view>
      </view>

      <!-- 生成按钮 -->
      <button class="generate-btn" bindtap="generateVideo">
        开始生成
      </button>
    </view>

    <!-- 生成进度显示 -->
    <view class="progress-section" wx:if="{{isGenerating}}">
    <view class="progress-header">
      <text class="progress-title">📹 视频生成中...</text>
      <text class="progress-status">{{statusText}}</text>
    </view>

    <view class="progress-bar-container">
      <view class="progress-bar-fill" style="width: {{generationProgress}}%"></view>
    </view>

    <!-- 上传状态 -->
    <view class="upload-status" wx:if="{{isUploading}}">
      <text class="upload-icon">☁️</text>
      <text class="upload-text">正在上传到云存储...</text>
    </view>

    <text class="progress-info">⏱️ 预计需要2分钟，请耐心等待</text>

      <button class="cancel-btn" bindtap="cancelGeneration" wx:if="{{!isUploading}}">取消生成</button>
    </view>

    <!-- 图片生成结果 -->
    <view class="image-result-section" wx:if="{{imageUrl && !isGenerating}}">
    <view class="result-header">
      <text class="result-title">✅ 生成成功！</text>
    </view>
    <view class="image-display">
      <image
        class="generated-image"
        src="{{imageUrl}}"
        mode="aspectFit"
        bindtap="previewImage"
      />
    </view>
    <view class="image-actions">
      <button class="action-btn" bindtap="saveImageToGallery">保存到相册</button>
      <button class="action-btn secondary" bindtap="generateVideoFromImage">用此图片生成视频</button>
    </view>
    
    <!-- 优化图片区域 -->
    <view class="optimize-section">
      <view class="optimize-header">
        <text class="optimize-title">🎨 不满意？继续优化</text>
        <text class="optimize-desc">输入新的提示词来改进图片效果</text>
      </view>
      <view class="optimize-input-wrapper">
        <textarea
          class="optimize-input"
          placeholder="例如：增加更多细节，改变风格，调整颜色..."
          value="{{optimizePrompt}}"
          bindinput="onOptimizePromptInput"
          maxlength="300"
          auto-height
        />
        <text class="char-count">{{optimizePrompt.length}}/300</text>
      </view>
      <button class="optimize-btn" bindtap="optimizeImage">
        ✨ 优化图片
      </button>
    </view>
    </view>

    <!-- 视频播放区域 -->
    <view class="result-section" wx:if="{{videoUrl && !isGenerating}}">
    <view class="result-header">
      <text class="result-title">✅ 生成成功！</text>
    </view>
    <view class="video-info">
      <text class="video-url">视频地址: {{videoUrl}}</text>
    </view>
    <video
      class="video-player"
      src="{{videoUrl}}"
      controls
      autoplay
      bindplay="onVideoPlay"
      binderror="onVideoError"
      bindload="onVideoLoad"
      show-center-play-btn="{{true}}"
      show-play-btn="{{true}}"
      />
    </view>

    <!-- 错误信息 -->
    <view class="error-section" wx:if="{{errorMessage}}">
      <text class="error-text">❌ {{errorMessage}}</text>
      <view class="debug-info">
        <text class="debug-title">调试信息：</text>
        <text class="debug-text">API地址: {{apiBaseUrl}}</text>
        <text class="debug-text" wx:if="{{debugNetworkType}}">网络类型: {{debugNetworkType}}</text>
      </view>
    </view>
  </view>
</view>



